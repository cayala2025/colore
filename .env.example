# Sender for all emails. Dev: Resend's test sender (it can only email your Resend account address).
# Production needs a domain verified in Resend, e.g. "Coloré <reservas@colore.mx>". Gmail/free addresses get a 403.
EMAIL_FROM="Coloré <onboarding@resend.dev>"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=
CRON_SECRET=
# Your own email. Database tests (test:db, test:e2e) name their rows "TEST", use this email, and delete
# them at the end. Those suites are LOCKED: run them only on purpose with
#   ALLOW_LIVE_DB_TESTS=yes npm run test:e2e
TEST_EMAIL=
